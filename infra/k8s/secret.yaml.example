apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
stringData:
  # ---------------------------------------------------------------------------
  # PRGuardian runtime secrets. Copy this file to secret.yaml, fill in every
  # value, apply it with `kubectl apply -f secret.yaml`, and NEVER commit
  # secret.yaml (it is listed in .gitignore).
  # ---------------------------------------------------------------------------

  # From the GitHub App settings page (Phase 5 in the README)
  GITHUB_WEBHOOK_SECRET: "REPLACE_WITH_THE_WEBHOOK_SECRET_YOU_TYPED_INTO_THE_GITHUB_APP"
  GITHUB_APP_ID: "REPLACE_WITH_APP_ID"
  GITHUB_APP_PRIVATE_KEY: |
    -----BEGIN RSA PRIVATE KEY-----
    REPLACE_WITH_THE_FULL_CONTENTS_OF_THE_DOWNLOADED_PEM_FILE
    -----END RSA PRIVATE KEY-----

  # From https://platform.openai.com/api-keys
  OPENAI_API_KEY: "sk-REPLACE"

  # From the Langfuse project settings (Phase 6)
  LANGFUSE_PUBLIC_KEY: "pk-lf-REPLACE"
  LANGFUSE_SECRET_KEY: "sk-lf-REPLACE"

  # Build from `terraform output rds_endpoint` and the db_password you chose:
  # postgresql+asyncpg://dbadmin:<db_password>@<rds_endpoint>/prguardian
  DATABASE_URL: "postgresql+asyncpg://dbadmin:REPLACE_DB_PASSWORD@REPLACE_RDS_ENDPOINT:5432/prguardian"
